        bind_signal_once(signal_id((_sh07_road_rage::civ1).field_0, "entity::AI_GET_IN_CAR_FINISHED"), _sh07_road_rage::all_aboard_update(0));
        bind_signal_once(signal_id(_sh07_road_rage::global_48, "entity::TRAFFIC_CAR_KILLED"), _sh07_road_rage::test_get_out());
        _sh07_road_rage::all_aboard_watch();
