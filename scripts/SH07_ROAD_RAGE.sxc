        bind_signal_once(signal_id((_sh07_road_rage::civ_car).field_0, "entity::MAX_DISTANCE_EXCEEDED"), _sh07_road_rage::rage_failure());
        if ((((_sh07_road_rage::civ1).field_0).get_ifc_num("SD_NUM_5") == 16)) {
