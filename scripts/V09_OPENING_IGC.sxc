    void _v09_opening_igc::opening_igc_effects()
    {
        entity v0 = create_entity("effects\\entities\\entity_event", "Shield_Center");
        bind_signal(signal_id(v0, "entity::ATTACK_BEGIN"), _v09_opening_igc::turn_on_field(v0));
    }

    void _v09_opening_igc::turn_on_field(entity p0)
    {
        entity fx_traskfield01 = create_entity("effects\\entities\\fx_traskfield01");
        entity fx_trask_cagewall = create_entity("effects\\aeps\\fx_trask_cagewall");
        entity entity_local_v0 = create_entity("effects\\aeps\\fx_trask_cagewall");
        entity entity_local_v1 = create_entity("effects\\aeps\\fx_trask_cagewall");
        entity entity_local_v2 = create_entity("effects\\aeps\\fx_trask_cagewall");
        (fx_traskfield01).set_rel_position((p0).get_abs_position());
        (fx_trask_cagewall).set_rel_position(((p0).get_abs_position() + vector3d(0, 0, -4)));
        (entity_local_v0).set_rel_position(((p0).get_abs_position() + vector3d(0, 0, 4)));
        (entity_local_v1).set_rel_position(((p0).get_abs_position() + vector3d(-4, 0, 0)));
        (entity_local_v2).set_rel_position(((p0).get_abs_position() + vector3d(4, 0, 0)));
        (entity_local_v1).wait_rotate(vector3d(0, 1, 0), 1.57, 0);
        (entity_local_v2).wait_rotate(vector3d(0, 1, 0), 1.57, 0);
        bind_signal(signal_id(p0, "entity::ATTACK_END"), _v09_opening_igc::turn_off_field(fx_traskfield01, fx_trask_cagewall, entity_local_v0, entity_local_v1, entity_local_v2));
    }

