    void _s04_rhino_beatdown::prepare_open_city_vars()
    {
        if ((!gv_story_finished)) {
            _s04_rhino_beatdown::update_open_city_times();
            if ((!is_hero_spidey())) {
                _s04_rhino_beatdown::switch_to_spiderman();
            }
        }
        g_story_checkpoint = 0;
        g_enable_story = 0;
        gv_num_current_story = _s04_rhino_beatdown::adjust_mission_num(gv_num_current_story);
        if (is_hero_spidey()) {
            _s04_rhino_beatdown::set_TOD_and_shoreline(gv_current_city_tod);
        } else {
            _s04_rhino_beatdown::set_TOD_and_shoreline(gv_current_venom_city_tod);
        }
        g_enable_igc = 0;
        g_enable_venom_igc = 0;
        g_mission_status = 0;
        g_mission_type = 0;
        g_enable_sh = 1;
        g_enable_can = 1;
        g_switch_to_open_city_music = 1;
        g_enable_token_event = 0;
        g_enable_trick_race = 0;
        g_enable_venom_trick_race = 0;
        gv_num_current_token_event = 0;
        _s04_rhino_beatdown::enable_mission_tokens_by_hero();
    }

    void _s04_rhino_beatdown::clear_missions_for_unlockables()
    {
        g_unlockables_entered = 1;
        blackscreen_on(0);
        num v1 = g_mission_type;
        num v0 = g_queens_tour_running;
        _s04_rhino_beatdown::prepare_open_city_vars();
        g_trick_race_restarted = 0;
        g_enable_trick_race = 0;
        g_enable_storm_race = 0;
        g_enable_venom_trick_race = 0;
        g_torch_race_running = 0;
        g_trick_race_running = 0;
        _s04_rhino_beatdown::clear_all_scripts();
        if (((v1 == 4) || (v0 == 1))) {
            _s04_rhino_beatdown::go_to_my_neighborhood(gv_hero_restart_pos);
        }
        blackscreen_off(0);
        invoke_pause_menu_unlockables();
        raise_signal("MISSION_START_UPDATE");
        g_unlockables_entered = 0;
    }

    void _s04_rhino_beatdown::progression_mission_failed()
    {
        blackscreen_on(0);
        spiderman_camera_clear_fixedstatic();
        _s04_rhino_beatdown::prepare_open_city_vars();
        _s04_rhino_beatdown::clear_all_scripts();
        _s04_rhino_beatdown::go_to_my_neighborhood(gv_hero_restart_pos);
        raise_signal("MISSION_START_UPDATE");
        blackscreen_off(1);
    }

    void _s04_rhino_beatdown::progression_mission_aborted()
    {
        if ((g_mission_type == 4)) {
            stop_vibration();
            clear_controls();
        }
        if (((hero()).get_ifc_num("HIT_POINTS") > 0)) {
            g_story_checkpoint = 0;
            if ((g_mission_type == 3)) {
