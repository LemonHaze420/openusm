    void _s04_rhino_beatdown::toggle_hero()
    {
        blackscreen_on(0);
        stop_vibration();
        kill_threads(_s04_rhino_beatdown::run_hot_pursuit);
        g_enable_hot_pursuit = 0;
        _s04_rhino_beatdown::clear_all_scripts();
        if (is_hero_venom()) {
            gv_current_city_tod = _s04_rhino_beatdown::cycle_tod(gv_current_city_tod);
            _s04_rhino_beatdown::switch_to_spiderman();
        } else {
            gv_current_venom_city_tod = _s04_rhino_beatdown::cycle_tod(gv_current_venom_city_tod);
            _s04_rhino_beatdown::switch_to_venom();
            start_thread(_s04_rhino_beatdown::hot_pursuit_checker());
        }
        _s04_rhino_beatdown::prepare_open_city_vars();
        blackscreen_off(1);
    }

