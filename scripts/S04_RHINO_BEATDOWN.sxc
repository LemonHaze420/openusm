    void _s04_rhino_beatdown::set_hero_costume(str p0)
    {
        blackscreen_on(0);
        stop_vibration();
        kill_threads(_s04_rhino_beatdown::run_hot_pursuit);
        g_enable_hot_pursuit = 0;
