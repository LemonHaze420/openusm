    void _s04_rhino_beatdown::failure_dialog(num p0)
    {
        num v1 = 3;
        num v0 = 0;
        shut_up_all_ai_voice_boxes();
        blackscreen_off(0);
        _global_slc::wait_frame();
        if (((gv_num_current_story == 1) || (gv_num_current_story == 2))) {
            v0 = 1;
        }
        if (v0) {
            v1 = 0;
        } else if ((p0 == -1)) {
            v1 = bring_up_dialog_box_title(30, 0, 31);
        } else {
            v1 = bring_up_dialog_box_title(p0, 0, 31);
        }
        if ((v1 == 0)) {
            blackscreen_on(0);
            (hero()).set_ifc_num("HIT_POINTS", (hero()).get_ifc_num("MAX_HIT_POINTS"));
            end_cut_scenes();
            _s04_rhino_beatdown::clear_all_scripts();
        } else {
            blackscreen_on(0);
            (hero()).set_ifc_num("HIT_POINTS", (hero()).get_ifc_num("MAX_HIT_POINTS"));
            g_story_checkpoint = 0;
            end_cut_scenes();
            raise_signal("MISSION_END_FAIL");
            _s04_rhino_beatdown::clear_all_scripts();
