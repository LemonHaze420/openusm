    void ENX_MASTER_OBJECT::setup_rhino_hits(entity p4)
    {
        field_16 = create_entity_list();
        num v0 = 0;
        while ((v0 < 10)) {
            entity nullo = create_entity("items\\entities\\nullo");
            (nullo).set_render_scale(vector3d(0.2, 0.2, 0.2));
            (nullo).set_visible(0);
            (field_16).add(nullo);
            v0++;
        }
        ((field_16).get_index(0)).set_parent((p4).get_member("BIP01 HEAD"));
        ((field_16).get_index(1)).set_parent((p4).get_member("BIP01 HEAD"));
        ((field_16).get_index(2)).set_parent((p4).get_member("R_shoulder"));
        ((field_16).get_index(3)).set_parent((p4).get_member("L_shoulder"));
        ((field_16).get_index(4)).set_parent((p4).get_member("Bip01 Spine2"));
        ((field_16).get_index(5)).set_parent((p4).get_member("Bip01 Spine2"));
        ((field_16).get_index(6)).set_parent((p4).get_member("Bip01 Spine2"));
        ((field_16).get_index(7)).set_parent((p4).get_member("Bip01 Spine2"));
        ((field_16).get_index(8)).set_parent((p4).get_member("Bip01 R Hand"));
        ((field_16).get_index(9)).set_parent((p4).get_member("Bip01 L Hand"));
        ((field_16).get_index(0)).set_rel_position(vector3d(0.05, 0.2, 0.05));
        ((field_16).get_index(1)).set_rel_position(vector3d(0.05, -0.2, 0.05));
        ((field_16).get_index(2)).set_rel_position(vector3d(0, 0.2, 0.6));
        ((field_16).get_index(3)).set_rel_position(vector3d(0, 0.2, 0.6));
        ((field_16).get_index(4)).set_rel_position(vector3d(-0.25, 0.5, 0.85));
        ((field_16).get_index(5)).set_rel_position(vector3d(-0.25, -0.5, 0.85));
        ((field_16).get_index(6)).set_rel_position(vector3d(-0.5, 0.5, -0.8));
        ((field_16).get_index(7)).set_rel_position(vector3d(-0.5, -0.5, -0.8));
        ((field_16).get_index(8)).set_rel_position(vector3d(-0.5, 0, 0.35));
        ((field_16).get_index(9)).set_rel_position(vector3d(-0.5, 0, 0.35));
        field_20 = 1;
    }

    void ENX_MASTER_OBJECT::hit_rhino(item p4, vector3d p8)
    {
        entity fx_bullethit = create_entity("effects\\aeps\\fx_bullethit");
        num v2 = 0;
        num v3 = distance3d(p8, ((field_16).get_index(0)).get_abs_position());
        num v4 = 0;
        vector3d v1 = (p4).get_abs_position();
        while ((v2 < 10)) {
            num v5 = distance3d(p8, ((field_16).get_index(v2)).get_abs_position());
            if ((v5 < v3)) {
                v4 = v2;
            }
            v2++;
        }
        (fx_bullethit).set_rel_position(((field_16).get_index(v4)).get_abs_position());
        (fx_bullethit).look_at((v1 - (v1 * 2)));
        (fx_bullethit).set_visible(1);
    }

    num ENX_MASTER_OBJECT::shot_rhino(entity p4)
    {
        if (entity_exists("Rhino")) {
            entity v0 = find_entity("Rhino");
            if ((p4 == v0)) {
                if ((!field_20)) {
                    (this).setup_rhino_hits(p4);
