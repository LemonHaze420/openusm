        } else {
            _v03_throw_down::set_TOD_and_shoreline(gv_current_venom_city_tod);
        }
        g_enable_igc = 0;
        g_enable_venom_igc = 0;
        g_mission_status = 0;
        g_mission_type = 0;
        g_enable_sh = 1;
        g_enable_can = 1;
        g_switch_to_open_city_music = 1;
        g_enable_token_event = 0;
        g_enable_trick_race = 0;
