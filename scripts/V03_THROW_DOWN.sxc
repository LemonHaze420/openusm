    void _v03_throw_down::set_tour_tokens()
    {
        num v0 = 0;
        num v1 = 0;
        while ((v0 < 16)) {
            if ((gv_tour_diff_ulocked >= gv_tour_difficulty[v0])) {
                v1 = get_token_index_from_id(6, v0);
                gv_token_collected[v1] = 0;
            } else {
                v1 = get_token_index_from_id(6, v0);
                gv_token_collected[v1] = 1;
            }
            v0++;
        }
    }

    void _v03_throw_down::set_up_tokens(num p0, num p4)
    {
        if ((_v03_throw_down::convert_to_progression_step(p0) <= _v03_throw_down::convert_to_progression_step(35))) {
            _v03_throw_down::disable_all_tokens();
        } else {
            _v03_throw_down::enable_pickup_tokens();
            if (((g_mission_type == 0) || (g_mission_type == 1))) {
                _v03_throw_down::set_torch_token(p4);
                if (is_hero_spidey()) {
                    _v03_throw_down::set_tour_tokens();
                    enable_tokens_of_type(4, 1);
                    enable_tokens_of_type(5, 0);
                } else {
                    enable_tokens_of_type(4, 0);
                    if (gv_story_finished) {
                        enable_tokens_of_type(5, 1);
                    }
                }
                if (((_v03_throw_down::convert_to_progression_step(p0) > _v03_throw_down::convert_to_progression_step(40)) && is_hero_spidey())) {
                    enable_tokens_of_type(6, 1);
                } else {
                    enable_tokens_of_type(6, 0);
                }
            }
        }
    }

    void _v03_throw_down::set_spiderman_health()
    {
        switch (gv_health_ulocked) {
        case 3:
        {
            turn_on_hero_health(3, hero());
            break;
        }
        case 2:
        {
            turn_on_hero_health(2, hero());
            break;
        }
        case 1:
        {
            turn_on_hero_health(1, hero());
            break;
        }
        default:
        {
            turn_on_hero_health(0, hero());
            break;
        }
        }
        (hero()).set_ifc_num("MAX_HIT_POINTS", gv_current_max_hitpoints);
        (hero()).set_ifc_num("HIT_POINTS", (hero()).get_ifc_num("MAX_HIT_POINTS"));
    }

    void _v03_throw_down::city_goals_hint()
    {
        while ((!gv_master_prog[gv_obj_list_needed])) {
            delay(180);
            while ((g_mission_status != 0)) {
                delay(1);
            }
            if ((!gv_master_prog[gv_obj_list_needed])) {
                set_mission_text_box_flavor(1);
                set_mission_text(275);
                delay(5);
                turn_off_mission_text();
            }
        }
    }

