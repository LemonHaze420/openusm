        g_enable_storm_race = 0;
        g_enable_venom_trick_race = 0;
        g_torch_race_running = 0;
        g_trick_race_running = 0;
        _v03_throw_down::clear_all_scripts();
        if (((v1 == 4) || (v0 == 1))) {
            _v03_throw_down::go_to_my_neighborhood(gv_hero_restart_pos);
        }
        blackscreen_off(0);
