    void _vmg_hot_pursuit::wait_frame(num p0)
    {
        while ((p0 > 0)) {
            _global_slc::wait_frame();
            p0--;
        }
    }

    void _vmg_hot_pursuit::banish(entity p0)
    {
        (p0).suspend();
        (p0).disable_collisions();
        (p0).set_rel_position(vector3d(-999, -999, -999));
        (p0).set_visible(0);
        (p0).set_physical(0);
    }

    void _vmg_hot_pursuit::unbanish(entity p0)
    {
        (p0).unsuspend();
        (p0).enable_collisions();
        (p0).set_visible(1);
        (p0).set_physical(1);
    }

    void _vmg_hot_pursuit::clear_all_scripts()
    {
        if (is_mission_loading()) {
            while ((!is_mission_active())) {
                _global_slc::wait_frame();
            }
        }
        unload_script();
        while (is_mission_active()) {
            _global_slc::wait_frame();
        }
    }

    void _vmg_hot_pursuit::go_to_my_neighborhood(vector3d p0)
    {
        district v2;
        district v1;
        num v3 = 0;
        if ((hero()).physical_ifc_is_biped_physics_running()) {
            (hero()).physical_ifc_stop_biped_physics();
        }
        if (is_hero_venom()) {
            malor(RESPAWN_CENTRAL_PARK, 1);
        } else {
            v2 = find_district_for_point(p0);
            v3 = (v2).get_neighborhood();
            switch (v3) {
            case 0:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            case 1:
            {
                malor(RESPAWN_ESU, 1);
                break;
            }
            case 2:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            case 3:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            default:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            }
        }
        v1 = find_district_for_point((hero()).get_abs_position());
        (v1).wait_for_load();
        wait_for_streamer_to_reach_equilibrium();
    }

