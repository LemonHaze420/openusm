            _city_arena::handle_unlocking(gv_num_current_story, 1);
            wait_for_streamer_to_reach_equilibrium();
            blackscreen_off(1);
            delay(1);
            if ((v0 != gv_obj_list_needed)) {
                if (((!(gv_num_current_story == 42)) && (!(gv_num_current_story == 24)))) {
                    if (gv_master_prog[gv_obj_list_needed]) {
                        kill_threads_on(this, _city_arena::city_goals_hint);
                        set_dialog_box_flavor(2);
                        bring_up_dialog_box_title(274, 1, 175);
                    } else {
                        set_mission_text_box_flavor(2);
                        set_mission_text(273);
                        start_thread_on(this, _city_arena::city_goals_hint());
                    }
                    _city_arena::kill_mission_text(3);
                }
            }
            if ((gv_num_current_story == 35)) {
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(316, 1, 283);
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(305, 1, 304);
            } else if ((gv_num_current_story == 36)) {
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(129, 1, 128);
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(314, 1, 313);
            } else if ((gv_num_current_story == 24)) {
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(23, 1, 128);
            } else if ((gv_num_current_story == 27)) {
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(300, 1, 297);
            } else if ((gv_num_current_story == 11)) {
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(298, 1, 297);
            }
            raise_signal("MISSION_START_UPDATE");
        }
    }

    void mission_handler::mission_finished()
    {
        g_enable_story = 0;
        switch (g_mission_status) {
        case 2:
        {
            (this).mission_success();
            break;
        }
        case 3:
        {
            _city_arena::progression_mission_failed();
            break;
        }
        case 4:
        {
            _city_arena::progression_mission_aborted();
            break;
        }
        default:
        {
            (this).mission_success();
            break;
        }
        }
    }

