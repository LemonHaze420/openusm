    void _city_arena::hoodname()
    {
        while (1) {
            if (hero_exists()) {
                district v0 = find_district_for_point((hero()).get_abs_position());
                num v1 = (v0).get_neighborhood();
                add_2d_debug_str(vector3d(500, 440, 0), vector3d(0.2, 1, 0.2), 1.1, get_neighborhood_name(v1), 1.4);
                add_2d_debug_str(vector3d(500, 460, 0), vector3d(0.2, 0.2, 1), 1.1, to_integer_string((v0).get_id()), 1);
                delay(1);
            } else {
                wait_frame();
            }
        }
    }

    void _city_arena::toggle_strafe(debug_menu_entry p0)
    {
        num v0 = (hero()).get_ai_param_int("lock_on_target");
        if (v0) {
