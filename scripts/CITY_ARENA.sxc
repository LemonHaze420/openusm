    void mission_handler::handle_load_game()
    {
        swap_hero_costume("ultimate_spiderman");
        vector3d v0;
        g_story_checkpoint = 0;
        blackscreen_on(0);
        freeze_hero(1);
        v0 = _city_arena::get_hero_start_point(gv_num_current_story);
        malor(v0, 1);
        wait_for_streamer_to_reach_equilibrium();
        spiderman_camera_autocorrect(0);
        _city_arena::set_spiderman_health();
        _city_arena::prepare_open_city_vars();
        (this).initialize_district_variants(gv_num_current_story);
        _city_arena::set_current_progression(gv_num_current_story);
        _city_arena::set_master_objective();
        _city_arena::set_progression_display_vars();
        _city_arena::handle_unlocking(gv_num_current_story, 0);
        turn_off_mission_text();
        raise_signal("MISSION_START_UPDATE");
        blackscreen_off(1);
        delay(1);
    }

