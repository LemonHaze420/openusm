            v0 = create_time_limited_entity("effects\\aeps\\fx_carsplash", (2 + 1));
        } else {
            v0 = create_time_limited_entity("effects\\aeps\\fx_charactersplash", (2 + 1));
        }
        v2 = vector3d(((p0).get_abs_position()).x(), -3, ((p0).get_abs_position()).z());
        (v0).set_rel_position(v2);
        _city_arena::daytime_tint_effect(v0);
        {
            sound_inst v3;
            if ((p0).is_a_car()) {
                v3 = create_sound_inst("car_oceansplash");
            } else {
                v3 = create_sound_inst("sm_oceansplash");
            }
            (v3).set_entity(p0);
            (v3).play(0);
        }
        (p0).reset_ai();
        (p0).physical_ifc_cancel_all_velocity();
        if ((p0 != hero())) {
            (p0).set_visible(0);
            (p0).apply_damage(2000);
            (p0).apply_subdue(200);
        } else {
            freeze_hero(1);
            (hero()).set_visible(0);
            (hero()).set_physical(0);
            vector3d v1 = (hero()).get_abs_position();
            (hero()).set_rel_position(vector3d((v1).x(), -2, (v1).z()));
            spiderman_camera_set_hero_underwater(1);
