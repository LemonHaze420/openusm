    num _queens_combat_tour3::distance2d(vector3d p0, vector3d p12)
    {
        vector3d v0 = (p0 + vector3d(0, (-(p0).y()), 0));
        vector3d v1 = (p12 + vector3d(0, (-(p12).y()), 0));
        num v2 = distance3d(v0, v1);
        return v2;
    }

    void _queens_combat_tour3::kill_mission_text(num p0)
    {
        if ((p0 > 0)) {
            delay(p0);
        }
        turn_off_mission_text();
    }

    void _queens_combat_tour3::clear_all_scripts()
    {
        if (is_mission_loading()) {
            while ((!is_mission_active())) {
                wait_frame();
            }
        }
        unload_script();
        while (is_mission_active()) {
            wait_frame();
        }
    }

    void _queens_combat_tour3::go_to_my_neighborhood(vector3d p0)
    {
        district v2;
        district v1;
        num v3 = 0;
        if ((hero()).physical_ifc_is_biped_physics_running()) {
            (hero()).physical_ifc_stop_biped_physics();
        }
        if (is_hero_venom()) {
            malor(RESPAWN_CENTRAL_PARK, 1);
        } else {
            v2 = find_district_for_point(p0);
            v3 = (v2).get_neighborhood();
            switch (v3) {
            case 0:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            case 1:
            {
                malor(RESPAWN_ESU, 1);
                break;
            }
            case 2:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            case 3:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            default:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            }
        }
        v1 = find_district_for_point((hero()).get_abs_position());
        (v1).wait_for_load();
        wait_for_streamer_to_reach_equilibrium();
    }

    void _queens_combat_tour3::city_tutorial_manager(num p0, num p4, num p8)
    {
        if ((p0 == 0)) {
            if ((!gv_city_tutorials[0])) {
                gv_city_tutorials[0] = 1;
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(131, 1, 130);
            }
        } else if ((p0 == 1)) {
            if ((!gv_city_tutorials[5])) {
                blackscreen_off(0);
                gv_city_tutorials[5] = 1;
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(76, 1, 75);
            }
        } else if ((p0 == 2)) {
            switch (p8) {
            case 0:
            {
                if ((!gv_city_tutorials[6])) {
                    gv_city_tutorials[6] = 1;
                    set_dialog_box_flavor(1);
                    bring_up_dialog_box_title(239, 1, 238);
                }
                break;
            }
            case 1:
            {
                if ((!gv_city_tutorials[7])) {
                    gv_city_tutorials[7] = 1;
                    set_dialog_box_flavor(1);
                    bring_up_dialog_box_title(241, 1, 240);
                }
                break;
            }
            case 2:
            {
                if ((!gv_city_tutorials[8])) {
                    gv_city_tutorials[8] = 1;
                    set_dialog_box_flavor(1);
                    bring_up_dialog_box_title(237, 1, 236);
                }
                break;
            }
            }
        }
    }

    void _queens_combat_tour3::display_car_combat_warning_panel(num p0)
    {
        _queens_combat_tour3::show_car_combat_help_text(3);
        if (p0) {
            cut_scene v0 = create_cut_scene("cutscenes\\encounters\\patrols\\gun_panel_left");
            (v0).wait_play();
        } else {
            cut_scene v0 = create_cut_scene("cutscenes\\encounters\\patrols\\gun_panel_right");
            (v0).wait_play();
        }
    }

    num _queens_combat_tour3::get_hood_gang(vector3d p0)
    {
        num v3 = -1;
        district v1;
        num v2 = 0;
        v1 = find_district_for_point(p0);
        v2 = (v1).get_neighborhood();
        switch (v2) {
        case 0:
        {
            v3 = 3;
            break;
        }
        case 1:
        {
            v3 = 2;
            break;
        }
        case 2:
        {
            v3 = 0;
            break;
        }
        case 3:
        {
            v3 = 1;
            break;
        }
        }
        return v3;
    }

