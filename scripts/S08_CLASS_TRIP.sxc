    void _s08_class_trip::wait_frame(num p0)
    {
        while ((p0 > 0)) {
            _global_slc::wait_frame();
            p0--;
        }
    }

    void _s08_class_trip::clear_all_scripts()
    {
        if (is_mission_loading()) {
            while ((!is_mission_active())) {
                _global_slc::wait_frame();
            }
        }
        unload_script();
        while (is_mission_active()) {
            _global_slc::wait_frame();
        }
    }

    void _s08_class_trip::go_to_my_neighborhood(vector3d p0)
    {
        district v2;
        district v1;
        num v3 = 0;
        if ((hero()).physical_ifc_is_biped_physics_running()) {
            (hero()).physical_ifc_stop_biped_physics();
        }
        if (is_hero_venom()) {
            malor(RESPAWN_CENTRAL_PARK, 1);
        } else {
            v2 = find_district_for_point(p0);
            v3 = (v2).get_neighborhood();
            switch (v3) {
            case 0:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            case 1:
            {
                malor(RESPAWN_ESU, 1);
                break;
            }
            case 2:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            case 3:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            default:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            }
        }
        v1 = find_district_for_point((hero()).get_abs_position());
        (v1).wait_for_load();
        wait_for_streamer_to_reach_equilibrium();
    }

    entity spawner::spawn_it()
    {
        if ((field_24).is_valid()) {
        } else {
            field_24 = create_entity(field_0, field_4);
            if ((field_24).is_valid()) {
                wait_frame();
                (field_24).set_rel_position((field_8).get_position());
                (field_24).set_xz_facing((field_8).get_facing());
            }
        }
        return field_24;
    }

    void spawner::destroy_it()
    {
        if ((field_24).is_valid()) {
            destroy_entity(field_24);
        }
    }

    void _s08_class_trip::start_mission_music()
    {
        g_ambient_music_allowed = 0;
        g_mission_music_active = 1;
        raise_signal("AMBIENT_MUSIC_FADE_OUT");
    }

    void _s08_class_trip::end_mission_success()
    {
        g_mission_music_active = 0;
    }

    void _s08_class_trip::end_mission_failed()
    {
        g_mission_music_active = 0;
    }

    void _s08_class_trip::city_tutorial_manager(num p0, num p4, num p8)
    {
        if ((p0 == 0)) {
            if ((!gv_city_tutorials[0])) {
                gv_city_tutorials[0] = 1;
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(131, 1, 130);
            }
        } else if ((p0 == 1)) {
            if ((!gv_city_tutorials[5])) {
                blackscreen_off(0);
                gv_city_tutorials[5] = 1;
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(76, 1, 75);
            }
        } else if ((p0 == 2)) {
            switch (p8) {
            case 0:
            {
                if ((!gv_city_tutorials[6])) {
                    gv_city_tutorials[6] = 1;
                    set_dialog_box_flavor(1);
                    bring_up_dialog_box_title(239, 1, 238);
                }
                break;
            }
            case 1:
            {
                if ((!gv_city_tutorials[7])) {
                    gv_city_tutorials[7] = 1;
                    set_dialog_box_flavor(1);
                    bring_up_dialog_box_title(241, 1, 240);
                }
                break;
            }
            case 2:
            {
                if ((!gv_city_tutorials[8])) {
                    gv_city_tutorials[8] = 1;
                    set_dialog_box_flavor(1);
                    bring_up_dialog_box_title(237, 1, 236);
                }
                break;
            }
            }
        }
    }

    void _s08_class_trip::display_car_combat_warning_panel(num p0)
    {
        _s08_class_trip::show_car_combat_help_text(3);
