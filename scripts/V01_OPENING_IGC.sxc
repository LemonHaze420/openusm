                (v2).set_visible(0);
            }
            blackscreen_off(0.01);
            (v0).wait_play();
            blackscreen_on(0.01);
            pop_pack("v01_igc1_1_pack");
            push_pack("v01_igc1_2_pack");
            cut_scene v3 = create_cut_scene("cutscenes\\v01_feeding_time\\igc\\v01_fdtm_igc1\\v01_fdtm_igc1_part2");
            blackscreen_off(0.01);
