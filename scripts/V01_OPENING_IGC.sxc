        entity v2 = create_entity("effects\\entities\\entity_event", "fx_powerline_0");
        entity v3 = create_entity("effects\\entities\\entity_event", "fx_powerline_1");
        entity v4 = create_entity("effects\\entities\\entity_event", "fx_powerline_2");
        entity v1 = create_entity("effects\\entities\\entity_event", "Gun_Flash");
        _v01_opening_igc::electric_spark(v2);
        _v01_opening_igc::electric_spark(v4);
        _v01_opening_igc::make_cable(v2, v3, v4);
        bind_signal(signal_id(v0, "entity::ANIM_ACTION"), _v01_opening_igc::shock_effect(v0));
        bind_signal(signal_id(v1, "entity::ATTACK"), _v01_opening_igc::pistol_flash(v1));
    }

