            push_pack("v01_igc1_1_pack");
            _v01_opening_igc::v01_igc1_effects_1();
            cut_scene v0 = create_cut_scene("cutscenes\\v01_feeding_time\\igc\\v01_fdtm_igc1\\v01_fdtm_igc1_part1");
