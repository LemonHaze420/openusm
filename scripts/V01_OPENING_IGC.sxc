    void _v01_opening_igc::make_cable(entity p0, entity p4, entity p8)
    {
        num v0 = 0;
        _v01_opening_igc::global_4 = create_polytube();
        (_v01_opening_igc::global_4).reserve_control_pts(3);
        while ((v0 < 3)) {
            (_v01_opening_igc::global_4).add_control_pt((p0).get_abs_position());
            v0++;
        }
        (_v01_opening_igc::global_4).set_tube_radius(0.06);
        (_v01_opening_igc::global_4).set_num_sides(6);
        (_v01_opening_igc::global_4).set_material("levels\\shared\\textures\\obj_cable");
        (_v01_opening_igc::global_4).set_render_color(vector3d(0.2, 0.2, 0.2));
        (_v01_opening_igc::global_4).set_tiles_per_meter(14);
        (_v01_opening_igc::global_4).build(8, 2);
        (_v01_opening_igc::global_4).compute_sector();
        start_thread(_v01_opening_igc::animate_cable(p0, p4, p8));
    }

    void _v01_opening_igc::animate_cable(entity p0, entity p4, entity p8)
    {
        _v01_opening_igc::global_0 = 1;
        while (_v01_opening_igc::global_0) {
            (_v01_opening_igc::global_4).set_control_pt(0, (p0).get_abs_position());
            (_v01_opening_igc::global_4).set_control_pt(1, (p4).get_abs_position());
            (_v01_opening_igc::global_4).set_control_pt(2, (p8).get_abs_position());
            wait_frame();
        }
    }

