    void _s05_opening_igc::s05_igc1_effects()
    {
        _s05_opening_igc::global_0 = 0;
        _s05_opening_igc::global_4 = create_entity("effects\\entities\\entity_event", "Beetle_Blast_Left");
        _s05_opening_igc::global_8 = create_entity("effects\\entities\\entity_event", "Beetle_Blast_Right");
        _s05_opening_igc::global_12 = create_entity("effects\\entities\\entity_event", "Beetle_Blast_Left_Target");
        _s05_opening_igc::global_16 = create_entity("effects\\entities\\entity_event", "Beetle_Blast_Right_Target");
        _s05_opening_igc::global_20 = create_entity("effects\\entities\\entity_event", "Soldier_Blast_Source");
        _s05_opening_igc::global_24 = create_entity("effects\\entities\\entity_event", "Soldier_Blast_Target");
        _s05_opening_igc::global_28 = create_entity("effects\\entities\\entity_event", "Bubble_Emitter");
        entity v4 = create_entity("effects\\entities\\entity_event", "Soldier_1_target");
        entity v3 = create_entity("effects\\entities\\entity_event", "Soldier_2_target");
        entity v2 = create_entity("effects\\entities\\entity_event", "Soldier_3_target");
        entity v1 = create_entity("effects\\entities\\entity_event", "Soldier_4_target");
        entity v0 = create_entity("effects\\entities\\entity_event", "Soldier_5_target");
        bind_signal(signal_id(v4, "entity::ATTACK"), _s05_opening_igc::laser_blast(_s05_opening_igc::global_4, v4));
        bind_signal(signal_id(v3, "entity::ATTACK"), _s05_opening_igc::laser_blast(_s05_opening_igc::global_4, v3));
        bind_signal(signal_id(v2, "entity::ATTACK"), _s05_opening_igc::laser_blast(_s05_opening_igc::global_4, v2));
        bind_signal(signal_id(v1, "entity::ATTACK"), _s05_opening_igc::laser_blast(_s05_opening_igc::global_4, v1));
        bind_signal(signal_id(v0, "entity::ATTACK"), _s05_opening_igc::laser_blast(_s05_opening_igc::global_4, v0));
        bind_signal(signal_id(_s05_opening_igc::global_28, "entity::ANIM_ACTION"), _s05_opening_igc::start_bubbles());
        bind_signal(signal_id(_s05_opening_igc::global_20, "entity::ANIM_ACTION"), _s05_opening_igc::shoot_soldier());
    }

    void _s05_opening_igc::laser_blast(entity p0, entity p4)
    {
        if ((!_s05_opening_igc::global_0)) {
            entity fx_beetle_blast_long = create_entity("effects\\aeps\\fx_beetle_blast_long");
            (fx_beetle_blast_long).set_rel_position((p0).get_abs_position());
            (fx_beetle_blast_long).look_at((p4).get_abs_position());
            _s05_opening_igc::global_32 = create_entity("effects\\aeps\\fx_beetle_plasmahit");
            (_s05_opening_igc::global_32).set_parent(p4);
        }
    }

    void _s05_opening_igc::start_bubbles()
    {
        if ((!_s05_opening_igc::global_0)) {
            entity fx_gg_cryo = create_entity("effects\\entities\\fx_gg_cryo");
            (fx_gg_cryo).set_rel_position((_s05_opening_igc::global_28).get_abs_position());
            delay(27);
            destroy_entity(fx_gg_cryo);
        }
    }

    void _s05_opening_igc::shoot_soldier()
    {
        if ((!_s05_opening_igc::global_0)) {
            entity fx_beetle_blast_long = create_entity("effects\\aeps\\fx_beetle_blast_long");
            entity fx_beetle_plasmahit = create_entity("effects\\aeps\\fx_beetle_plasmahit");
            (fx_beetle_blast_long).set_parent(_s05_opening_igc::global_20);
            (fx_beetle_blast_long).set_po_facing((_s05_opening_igc::global_24).get_abs_position());
            (fx_beetle_plasmahit).set_parent(_s05_opening_igc::global_24);
        }
    }

