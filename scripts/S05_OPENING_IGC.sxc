    _s05_opening_igc::_s05_opening_igc(num p0)
    {
        switch (p0) {
        case 0:
        {
            g_mission_status = 7;
            g_ambient_music_allowed = 0;
            push_pack("s05_igc1_pack");
            _s05_opening_igc::s05_igc1_effects();
            cut_scene v1 = create_cut_scene("cutscenes\\s05_sky_chase\\igc\\s05_sky_chase_igc1\\s05_skcs_igc1");
            enable_subtitles();
            subtitle(324, 2, 4.33, 0, 0, 0);
            (v1).wait_play();
            disable_subtitles();
            blackscreen_on(0.01);
            pop_pack("s05_igc1_pack");
            push_pack("s05_igc2_pack");
            cut_scene v2 = create_cut_scene("cutscenes\\s05_sky_chase\\igc\\s05_sky_chase_igc1\\s05_skcs_igc1_02");
            (v2).wait_play();
            blackscreen_on(0);
            g_mission_status = 2;
            g_ambient_music_allowed = 1;
            raise_signal("MISSION_END");
            while (is_mission_active()) {
                wait_frame();
            }
            break;
        }
        }
    }

