    void _s10_spidey_vs_sable::kill_shenanigans()
    {
        g_enable_sh = 0;
        g_enable_can = 0;
        _global_slc::wait_frame();
        if (is_mission_loading()) {
            while ((!is_mission_active())) {
                _global_slc::wait_frame();
            }
        }
        if ((is_mission_active() && (g_mission_type == 1))) {
            unload_script();
            while (is_mission_active()) {
                _global_slc::wait_frame();
            }
        }
    }

    void _s10_spidey_vs_sable::launch_combat_tour(num p0)
    {
