    void _s10_spidey_vs_sable::limbo_guardian(entity p0)
    {
        district v0 = (p0).get_district();
        vector3d v1 = (p0).get_abs_position();
        while ((p0).is_valid()) {
            while ((v0).is_loaded()) {
                _global_slc::wait_frame();
            }
            while ((!(v0).is_loaded())) {
                _global_slc::wait_frame();
            }
            (p0).set_rel_position(v1);
            (p0).set_visible(1);
        }
    }

    void _s10_spidey_vs_sable::mission_fail_spidey()
    {
        g_mission_status = 3;
        stop_vibration();
        stop_all_sounds();
        set_dialog_box_flavor(3);
        (hero()).reset_ai();
        start_thread(_s10_spidey_vs_sable::generic_spidey_lose_panel());
        delay(4.63);
        _s10_spidey_vs_sable::failure_dialog(-1);
    }

    void _s10_spidey_vs_sable::mission_fail_spidey_specific(num p0)
    {
        g_mission_status = 3;
