        (hero()).reset_ai();
        start_thread(_s10_spidey_vs_sable::generic_spidey_lose_panel());
        delay(4.63);
        _s10_spidey_vs_sable::failure_dialog(p0);
    }

    void _s10_spidey_vs_sable::clear_all_scripts()
    {
        if (is_mission_loading()) {
            while ((!is_mission_active())) {
                _global_slc::wait_frame();
            }
        }
        unload_script();
        while (is_mission_active()) {
            _global_slc::wait_frame();
        }
    }

    void _s10_spidey_vs_sable::failure_dialog(num p0)
    {
        num v1 = 3;
        num v0 = 0;
        shut_up_all_ai_voice_boxes();
        blackscreen_off(0);
        _global_slc::wait_frame();
        if (((gv_num_current_story == 1) || (gv_num_current_story == 2))) {
            v0 = 1;
        }
        if (v0) {
            v1 = 0;
        } else if ((p0 == -1)) {
            v1 = bring_up_dialog_box_title(30, 0, 31);
        } else {
            v1 = bring_up_dialog_box_title(p0, 0, 31);
        }
        if ((v1 == 0)) {
            blackscreen_on(0);
            (hero()).set_ifc_num("HIT_POINTS", (hero()).get_ifc_num("MAX_HIT_POINTS"));
            end_cut_scenes();
            _s10_spidey_vs_sable::clear_all_scripts();
        } else {
            blackscreen_on(0);
            (hero()).set_ifc_num("HIT_POINTS", (hero()).get_ifc_num("MAX_HIT_POINTS"));
            g_story_checkpoint = 0;
            end_cut_scenes();
            raise_signal("MISSION_END_FAIL");
            _s10_spidey_vs_sable::clear_all_scripts();
        }
    }

    void _s10_spidey_vs_sable::generic_spidey_lose_panel()
    {
        end_cut_scenes();
        cut_scene v0 = create_cut_scene("cutscenes\\in_game\\spidey_failpanel");
        (v0).wait_play();
    }

    void _s10_spidey_vs_sable::go_to_my_neighborhood(vector3d p0)
    {
        district v2;
        district v1;
        num v3 = 0;
        if ((hero()).physical_ifc_is_biped_physics_running()) {
            (hero()).physical_ifc_stop_biped_physics();
        }
        if (is_hero_venom()) {
            malor(RESPAWN_CENTRAL_PARK, 1);
        } else {
            v2 = find_district_for_point(p0);
            v3 = (v2).get_neighborhood();
            switch (v3) {
            case 0:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            case 1:
            {
                malor(RESPAWN_ESU, 1);
                break;
            }
            case 2:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            case 3:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            default:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            }
        }
        v1 = find_district_for_point((hero()).get_abs_position());
        (v1).wait_for_load();
        wait_for_streamer_to_reach_equilibrium();
    }

