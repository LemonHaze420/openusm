    void spidey_effects::spidey_sense(entity p4)
    {
        if ((field_4 == entity("NULL"))) {
            start_thread_on(this, (this).setup_spidey_sense());
        }
        (field_4).set_parent((p4).get_member("Bip01 Head"));
        (field_8).set_parent((p4).get_member("Bip01 Head"));
        (field_8).set_rel_position(vector3d(-0.2, 0, 0));
        num v0 = distance3d((p4).get_abs_position(), (chase_cam()).get_abs_position());
        v0 = (v0 * 0.35);
