    void _ultimate_spiderman::go_to_my_neighborhood(vector3d p0)
    {
        district v2;
        district v1;
        num v3 = 0;
        if ((hero()).physical_ifc_is_biped_physics_running()) {
            (hero()).physical_ifc_stop_biped_physics();
        }
        if (is_hero_venom()) {
            malor(RESPAWN_CENTRAL_PARK, 1);
        } else {
            v2 = find_district_for_point(p0);
            v3 = (v2).get_neighborhood();
            switch (v3) {
            case 0:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            case 1:
            {
                malor(RESPAWN_ESU, 1);
                break;
            }
            case 2:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            case 3:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            default:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            }
        }
        v1 = find_district_for_point((hero()).get_abs_position());
        (v1).wait_for_load();
        wait_for_streamer_to_reach_equilibrium();
    }

    void _ultimate_spiderman::hero_death()
    {
        (hero()).ai_shut_up();
        start_thread(_ultimate_spiderman::cancel_vibrations());
        if (g_enable_story) {
            num v2 = 0;
            num v0 = 0;
            if ((g_mission_status == 7)) {
                g_mission_status = 3;
            } else {
                v2 = 1;
            }
            if ((!v2)) {
                if (((gv_num_current_story == 1) || (gv_num_current_story == 2))) {
                    v0 = 1;
                }
                delay(3);
                turn_off_mission_text();
                set_dialog_box_flavor(3);
                num v1 = 3;
                if (v0) {
                    if (is_hero_venom()) {
                        v1 = bring_up_dialog_box_title(253, 1, 31);
                    } else {
                        v1 = bring_up_dialog_box_title(252, 1, 31);
                    }
                } else if (is_hero_venom()) {
                    v1 = bring_up_dialog_box_title(253, 0, 31);
                } else {
                    v1 = bring_up_dialog_box_title(252, 0, 31);
                }
                blackscreen_on(1);
                delay(1);
                (hero()).reset_ai();
                spiderman_camera_clear_fixedstatic();
                end_cut_scenes();
                if (((v1 == 0) || (v1 == 2))) {
                    unload_script();
                } else {
                    g_story_checkpoint = 0;
                    raise_signal("MISSION_END_FAIL");
                }
            }
            (hero()).set_ifc_num("HIT_POINTS", (hero()).get_ifc_num("MAX_HIT_POINTS"));
        } else {
            delay(3);
            turn_off_mission_text();
            set_dialog_box_flavor(3);
            num v2 = 3;
            if (g_enable_hot_pursuit) {
                _ultimate_spiderman::handle_respawn(0);
            } else if (((g_mission_type != 1) && is_mission_active())) {
                if (is_hero_venom()) {
                    v2 = bring_up_dialog_box_title(253, 0, 31);
                } else {
                    v2 = bring_up_dialog_box_title(252, 0, 31);
                }
                while ((v2 == 3)) {
                    wait_frame();
                }
                if ((v2 == 0)) {
                    start_thread(_ultimate_spiderman::handle_respawn(1));
                    delay(1);
                    raise_signal("DEATH_RETRY_YES");
                } else {
                    raise_signal("MISSION_END_FAIL");
                    raise_signal("DEATH_RETRY_NO");
                    _ultimate_spiderman::handle_respawn(0);
                }
            } else {
                if (is_hero_venom()) {
                    v2 = bring_up_dialog_box_title(268, 1, 31);
                } else {
                    v2 = bring_up_dialog_box_title(267, 1, 31);
                }
                while ((v2 == 3)) {
                    wait_frame();
                }
                _ultimate_spiderman::handle_respawn(0);
            }
        }
    }

    void _ultimate_spiderman::cancel_vibrations()
    {
        delay(1.5);
        stop_vibration();
    }

    void _ultimate_spiderman::handle_respawn(num p0)
    {
        blackscreen_on(1);
        delay(1);
        spiderman_camera_clear_fixedstatic();
        (hero()).reset_ai();
        if ((g_mission_type == 1)) {
            unload_script();
        }
        if (g_enable_hot_pursuit) {
            g_enable_hot_pursuit = 0;
            unload_script();
        }
        (hero()).set_ifc_num("HIT_POINTS", (hero()).get_ifc_num("MAX_HIT_POINTS"));
        if ((!p0)) {
            _ultimate_spiderman::go_to_my_neighborhood((hero()).get_abs_position());
            blackscreen_off(1);
            delay(1);
        }
    }

