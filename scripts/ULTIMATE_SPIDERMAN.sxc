        vector3d v6 = (v1 - v2);
        num v7 = (v6).length();
        vector3d v5 = (v6 / v7);
        vector3d v8 = (p4).get_abs_position();
        vector3d v9 = (v8 - v2);
        num v10 = (v9).length();
        vector3d v3 = (v9 / v10);
        (v0).set_control_pt(2, v2);
        (v0).set_control_pt(1, (v2 + (v5 * (1.3 / 2))));
        (v0).set_control_pt(0, (v2 + (v3 * 1.3)));
