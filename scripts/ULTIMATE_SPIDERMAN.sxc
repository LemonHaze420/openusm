    void motion_trail_effects::make_motion_trail(entity p4, entity p8)
    {
        num v4 = 0;
        vector3d v1 = (p8).get_abs_position();
        polytube v0 = create_polytube();
        (v0).set_rel_position(v1);
        (v0).reserve_control_pts(3);
        (v0).set_tube_radius(0.35);
        (v0).set_num_sides(2);
