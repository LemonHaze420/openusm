                    clear_controls();
                    spiderman_camera_enable_lookaround(0);
                    g_trick_race_controls_locked = 1;
                }
                g_race_exited_via_pause = 1;
                g_done_with_storm_anim = 1;
            } else {
                blackscreen_on(0);
                spiderman_camera_clear_fixedstatic();
                if ((gv_num_current_story == 42)) {
                    g_mission_status = 2;
                    raise_signal("MISSION_END");
                } else {
                    _pnxx_uncle_gts_playground::prepare_open_city_vars();
                    _pnxx_uncle_gts_playground::clear_all_scripts();
                    if ((g_mission_type != 1)) {
                        _pnxx_uncle_gts_playground::go_to_my_neighborhood(gv_hero_restart_pos);
                    }
                    raise_signal("MISSION_START_UPDATE");
                }
            }
            blackscreen_off(1);
        }
    }

