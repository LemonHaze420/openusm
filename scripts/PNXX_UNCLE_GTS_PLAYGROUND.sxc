    void _pnxx_uncle_gts_playground::failure_shutdown_entities(entity_list p0)
    {
        num v0 = 0;
        while ((v0 < (p0).size())) {
            raise_signal((p0).get_index(v0), "entity::SHUT_DOWN_SPAWNER");
            v0++;
        }
    }

    void _pnxx_uncle_gts_playground::left_token_trigger()
    {
        (script_controller("CONTROLLER_1")).clear_callbacks();
        if ((!g_trick_race_running)) {
        }
        turn_off_mission_text();
        if ((hero()).is_valid()) {
            (hero()).set_ai_param_int("loco_allow_punch", 1);
            (hero()).set_ai_param_int("loco_allow_web_zip", 1);
            (hero()).set_ai_param_int("loco_allow_swing", 1);
        }
    }

    void _pnxx_uncle_gts_playground::switch_to_spiderman()
    {
        _pnxx_uncle_gts_playground::set_hero("ultimate_spiderman");
    }

    void _pnxx_uncle_gts_playground::switch_to_venom()
    {
        if (gv_story_finished) {
            _pnxx_uncle_gts_playground::set_hero("venom_spider");
        } else {
            _pnxx_uncle_gts_playground::set_hero("venom");
