    void _pnxx_uncle_gts_playground::progression_mission_aborted()
    {
        if ((g_mission_type == 4)) {
            stop_vibration();
            clear_controls();
        }
        if (((hero()).get_ifc_num("HIT_POINTS") > 0)) {
            g_story_checkpoint = 0;
