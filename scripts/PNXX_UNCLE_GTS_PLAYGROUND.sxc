    void _pnxx_uncle_gts_playground::clear_all_scripts()
    {
        if (is_mission_loading()) {
            while ((!is_mission_active())) {
                _global_slc::wait_frame();
            }
        }
        unload_script();
        while (is_mission_active()) {
            _global_slc::wait_frame();
        }
    }

    void _pnxx_uncle_gts_playground::go_to_my_neighborhood(vector3d p0)
    {
        district v2;
        district v1;
        num v3 = 0;
        if ((hero()).physical_ifc_is_biped_physics_running()) {
            (hero()).physical_ifc_stop_biped_physics();
        }
        if (is_hero_venom()) {
            malor(RESPAWN_CENTRAL_PARK, 1);
        } else {
            v2 = find_district_for_point(p0);
            v3 = (v2).get_neighborhood();
            switch (v3) {
            case 0:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            case 1:
            {
                malor(RESPAWN_ESU, 1);
                break;
            }
            case 2:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            case 3:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            default:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            }
        }
        v1 = find_district_for_point((hero()).get_abs_position());
        (v1).wait_for_load();
        wait_for_streamer_to_reach_equilibrium();
    }

    void _pnxx_uncle_gts_playground::city_tutorial_manager(num p0, num p4, num p8)
    {
        if ((p0 == 0)) {
            if ((!gv_city_tutorials[0])) {
                gv_city_tutorials[0] = 1;
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(131, 1, 130);
            }
        } else if ((p0 == 1)) {
            if ((!gv_city_tutorials[5])) {
                blackscreen_off(0);
                gv_city_tutorials[5] = 1;
                set_dialog_box_flavor(1);
                bring_up_dialog_box_title(76, 1, 75);
            }
        } else if ((p0 == 2)) {
            switch (p8) {
            case 0:
            {
                if ((!gv_city_tutorials[6])) {
                    gv_city_tutorials[6] = 1;
                    set_dialog_box_flavor(1);
                    bring_up_dialog_box_title(239, 1, 238);
                }
                break;
            }
            case 1:
            {
                if ((!gv_city_tutorials[7])) {
                    gv_city_tutorials[7] = 1;
                    set_dialog_box_flavor(1);
                    bring_up_dialog_box_title(241, 1, 240);
                }
                break;
            }
            case 2:
            {
                if ((!gv_city_tutorials[8])) {
                    gv_city_tutorials[8] = 1;
                    set_dialog_box_flavor(1);
                    bring_up_dialog_box_title(237, 1, 236);
                }
                break;
            }
            }
        }
    }

    void _pnxx_uncle_gts_playground::display_car_combat_warning_panel(num p0)
    {
        _pnxx_uncle_gts_playground::show_car_combat_help_text(3);
        if (p0) {
            cut_scene v0 = create_cut_scene("cutscenes\\encounters\\patrols\\gun_panel_left");
            (v0).wait_play();
        } else {
            cut_scene v0 = create_cut_scene("cutscenes\\encounters\\patrols\\gun_panel_right");
            (v0).wait_play();
        }
    }

    num _pnxx_uncle_gts_playground::get_hood_gang(vector3d p0)
    {
        num v3 = -1;
        district v1;
        num v2 = 0;
        v1 = find_district_for_point(p0);
        v2 = (v1).get_neighborhood();
        switch (v2) {
        case 0:
        {
            v3 = 3;
            break;
        }
        case 1:
        {
            v3 = 2;
            break;
        }
        case 2:
        {
            v3 = 0;
            break;
        }
        case 3:
        {
            v3 = 1;
            break;
        }
        }
        return v3;
    }

    void _pnxx_uncle_gts_playground::set_hood_gang()
    {
        vector3d v0;
        v0 = get_mission_key_position();
        g_hood_gang = _pnxx_uncle_gts_playground::get_hood_gang(v0);
