    _pnxx_uncle_gts_playground::_pnxx_uncle_gts_playground(num p0)
    {
        _pnxx_uncle_gts_playground::set_force_patrol_vars(0);
        delay(2);
        turn_off_mission_text();
        _pnxx_uncle_gts_playground::wait_frame(2);
        _pnxx_uncle_gts_playground::initialize_patrol();
        _pnxx_uncle_gts_playground::initialize_entities();
        _pnxx_uncle_gts_playground::global_8 = get_mission_key_position();
        _pnxx_uncle_gts_playground::global_20 = (_pnxx_uncle_gts_playground::global_8 - vector3d(30, 0, 0));
        _pnxx_uncle_gts_playground::place_entities();
        while ((g_mission_status == 1)) {
            _global_slc::wait_frame();
        }
        if ((g_mission_status == 2)) {
            raise_signal((_pnxx_uncle_gts_playground::ent_cop_00).field_0, "entity::AI_WAIT_GO_AWAY");
            raise_signal((_pnxx_uncle_gts_playground::ent_cop_01).field_0, "entity::AI_WAIT_GO_AWAY");
            raise_signal((_pnxx_uncle_gts_playground::ent_cop_02).field_0, "entity::AI_WAIT_GO_AWAY");
            while ((g_entity_list).size()) {
                delay(0.5);
            }
        } else {
            _pnxx_uncle_gts_playground::failure_shutdown_entities(g_entity_list);
            while ((g_entity_list).size()) {
                delay(0.5);
            }
        }
        delay(5);
        turn_off_mission_text();
        unload_script();
    }

