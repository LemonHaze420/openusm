    _v09_ending_igc::_v09_ending_igc(num p0)
    {
        switch (p0) {
        case 0:
        {
            g_mission_type = 4;
            g_mission_status = 7;
            g_ambient_music_allowed = 0;
            _v09_ending_igc::v09_igc6_effects();
            cut_scene v1 = create_cut_scene("cutscenes\\v09_the_great_escape\\igc\\v09_gres_igc6\\v09_gres_igc6");
            (v1).wait_play();
            blackscreen_on(0.01);
            cut_scene v2 = create_cut_scene("cutscenes\\in_game\\ven_spidey_transition");
            (v2).wait_play();
            blackscreen_on(0.01);
            g_mission_status = 2;
            g_ambient_music_allowed = 1;
            raise_signal("MISSION_END");
            while (is_mission_active()) {
                wait_frame();
            }
            break;
        }
        }
    }

    _v09_ending_igc::~_v09_ending_igc()
