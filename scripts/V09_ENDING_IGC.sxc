    void _v09_ending_igc::v09_igc6_effects()
    {
        entity v7 = create_entity("effects\\entities\\entity_event", "Splash_01");
        entity v6 = create_entity("effects\\entities\\entity_event", "Splash_02");
        entity v5 = create_entity("effects\\entities\\entity_event", "Splash_03");
        entity v4 = create_entity("effects\\entities\\entity_event", "JetBlast_RR");
        entity v3 = create_entity("effects\\entities\\entity_event", "JetBlast_RL");
        entity v2 = create_entity("effects\\entities\\entity_event", "JetBlast_FL");
        entity v0 = create_entity("effects\\entities\\entity_event", "JetBlast_FR");
        entity v1 = create_entity("effects\\entities\\entity_event", "Venom_Fist");
        bind_signal(signal_id(v7, "entity::ANIM_ACTION"), _v09_ending_igc::create_splash(v7));
        bind_signal(signal_id(v6, "entity::ANIM_ACTION"), _v09_ending_igc::create_splash(v6));
        bind_signal(signal_id(v5, "entity::ANIM_ACTION"), _v09_ending_igc::create_splash(v5));
        bind_signal(signal_id(v4, "entity::ATTACK_BEGIN"), _v09_ending_igc::start_jets(v4));
        bind_signal(signal_id(v3, "entity::ATTACK_BEGIN"), _v09_ending_igc::start_jets(v3));
        bind_signal(signal_id(v2, "entity::ATTACK_BEGIN"), _v09_ending_igc::start_jets(v2));
        bind_signal(signal_id(v0, "entity::ATTACK_BEGIN"), _v09_ending_igc::start_jets(v0));
        bind_signal(signal_id(v1, "entity::ATTACK"), _v09_ending_igc::hit_spark(v1));
    }

    void _v09_ending_igc::hit_spark(entity p0)
    {
        entity fx_genhit_lg = create_entity("effects\\aeps\\fx_genhit_lg");
        (fx_genhit_lg).set_rel_position((p0).get_abs_position());
    }

    void _v09_ending_igc::create_splash(entity p0)
    {
        entity fx_sable_jetsplash = create_entity("effects\\aeps\\fx_sable_jetsplash");
        (fx_sable_jetsplash).set_render_scale(vector3d(3, 3, 3));
        (fx_sable_jetsplash).set_parent(p0);
    }

    void _v09_ending_igc::start_jets(entity p0)
    {
        entity fx_sable_jetblast = create_entity("effects\\aeps\\fx_sable_jetblast");
        (fx_sable_jetblast).set_distance_clip(1000);
        (fx_sable_jetblast).set_rel_position((p0).get_abs_position());
        (fx_sable_jetblast).set_po_facing(vector3d(0, -1, 0));
        (fx_sable_jetblast).set_parent(p0);
        bind_signal_once(signal_id(p0, "entity::ATTACK_END"), _v09_ending_igc::stop_jets(fx_sable_jetblast));
    }

    void _v09_ending_igc::stop_jets(entity p0)
    {
        destroy_entity(p0);
    }

