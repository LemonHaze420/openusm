            _s07_gg_vs_spidey::switch_to_venom();
            start_thread(_s07_gg_vs_spidey::hot_pursuit_checker());
        }
        _s07_gg_vs_spidey::prepare_open_city_vars();
        blackscreen_off(1);
    }

