    {
        blackscreen_on(0);
        stop_vibration();
        kill_threads(_s07_gg_vs_spidey::run_hot_pursuit);
        g_enable_hot_pursuit = 0;
        _s07_gg_vs_spidey::clear_all_scripts();
        if (is_hero_venom()) {
            gv_current_city_tod = _s07_gg_vs_spidey::cycle_tod(gv_current_city_tod);
            _s07_gg_vs_spidey::switch_to_spiderman();
