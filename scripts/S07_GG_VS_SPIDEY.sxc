        (_s07_gg_vs_spidey::global_208).enable_collisions();
    }

    void _s07_gg_vs_spidey::blackscreen_load()
    {
        blackscreen_on(0.01);
        freeze_hero(1);
    }

    void _s07_gg_vs_spidey::blackscreen_unload()
    {
        wait_for_streamer_to_reach_equilibrium();
        blackscreen_off(0.01);
        freeze_hero(0);
    }

    void _s07_gg_vs_spidey::failed_mission(num p0)
    {
        if (((p0 == 1) && (g_mission_status != 3))) {
            g_mission_status = 3;
            kill_threads(_s07_gg_vs_spidey::gg_ai_change);
            destroy_entity(_s07_gg_vs_spidey::global_276);
            _s07_gg_vs_spidey::mission_fail_spidey_specific(250);
        } else if (((p0 == 0) && (g_mission_status != 3))) {
            g_mission_status = 3;
            _s07_gg_vs_spidey::mission_fail_spidey_specific(251);
        }
    }

    void _s07_gg_vs_spidey::mission_called_from_debug_menu()
    {
        g_enable_sh = 0;
        g_enable_story = 1;
        gv_num_current_story = 10;
        raise_signal("MISSION_START_UPDATE");
    }

    void _s07_gg_vs_spidey::tracker_on()
    {
        _s07_gg_vs_spidey::global_384 = create_entity_tracker(_s07_gg_vs_spidey::global_276);
        (_s07_gg_vs_spidey::global_384).set_poi_icon(2);
        (_s07_gg_vs_spidey::global_384).set_poi_active(1);
        (_s07_gg_vs_spidey::global_384).set_health_widget_active(0);
    }

    void _s07_gg_vs_spidey::tam3_door_open()
    {
        (_s07_gg_vs_spidey::ai_auditor).puppet_play_anim(_s07_gg_vs_spidey::global_388, "s07_door_open", 1);
    }

    void _s07_gg_vs_spidey::tam3_run_out()
    {
        (_s07_gg_vs_spidey::ai_auditor).puppet_play_anim(_s07_gg_vs_spidey::global_216, "Run_Out_CarC", 1);
    }

    void _s07_gg_vs_spidey::sound_watcher()
    {
        if ((_s07_gg_vs_spidey::global_416 == 0)) {
            _s07_gg_vs_spidey::global_416 = 1;
            bind_signal_once(signal_id("FIREBALL_FIRED"), _s07_gg_vs_spidey::spidey_fireball_reaction());
            bind_signal_once(signal_id(_s07_gg_vs_spidey::global_276, "_s07_gg_vs_spidey::GOBLIN_TIRED"), _s07_gg_vs_spidey::goblin_getting_slap());
            bind_signal_once(signal_id(_s07_gg_vs_spidey::global_276, "_s07_gg_vs_spidey::GOBLIN_CHARGING"), _s07_gg_vs_spidey::goblin_charging_reaction());
            bind_signal_once(signal_id(_s07_gg_vs_spidey::global_276, "_s07_gg_vs_spidey::GOBLIN_JUMPING"), _s07_gg_vs_spidey::goblin_jumping_reaction());
            bind_signal_once(signal_id(_s07_gg_vs_spidey::global_276, "entity::DAMAGED"), _s07_gg_vs_spidey::goblin_got_hit());
        }
    }

    void _s07_gg_vs_spidey::goblin_getting_slap()
    {
        (hero()).ai_say_file("s07_01gp18_spi_whatdidthe", 2, 2);
        (hero()).ai_say_file("s07_01gp18_spi_slap", 2, 2);
        bind_signal_once(signal_id(_s07_gg_vs_spidey::global_276, "_s07_gg_vs_spidey::GOBLIN_TIRED"), _s07_gg_vs_spidey::goblin_tired_reaction());
    }

    void _s07_gg_vs_spidey::goblin_jumping_reaction()
    {
        (_s07_gg_vs_spidey::global_276).ai_say_file("s07_02gp15_gre_burn", 0, 1);
        bind_signal_once(signal_id(_s07_gg_vs_spidey::global_276, "_s07_gg_vs_spidey::GOBLIN_JUMPING"), _s07_gg_vs_spidey::goblin_jumping_reaction());
    }

    void _s07_gg_vs_spidey::goblin_charging_reaction()
    {
        (_s07_gg_vs_spidey::global_276).ai_wait_say_file("s07_02gp26_gre_gyaaaahhh", 2, 2);
        (_s07_gg_vs_spidey::global_276).ai_say_sound_group("S07_goblin_taunts", 2, 2);
        bind_signal_once(signal_id(_s07_gg_vs_spidey::global_276, "_s07_gg_vs_spidey::GOBLIN_CHARGING"), _s07_gg_vs_spidey::goblin_charging_reaction());
    }

    void _s07_gg_vs_spidey::goblin_tired_reaction()
    {
        (hero()).ai_say_sound_group("s07_goblin_tires", 2, 2);
        bind_signal_once(signal_id(_s07_gg_vs_spidey::global_276, "_s07_gg_vs_spidey::GOBLIN_TIRED"), _s07_gg_vs_spidey::goblin_tired_reaction());
    }

    void _s07_gg_vs_spidey::goblin_got_hit()
    {
        (hero()).ai_say_sound_group("s07_goblin_damaged", 0, 2);
        delay(5);
        bind_signal_once(signal_id(_s07_gg_vs_spidey::global_276, "entity::DAMAGED"), _s07_gg_vs_spidey::goblin_got_hit());
    }

    void _s07_gg_vs_spidey::spidey_fireball_reaction()
    {
        _s07_gg_vs_spidey::global_420 = 0;
        _s07_gg_vs_spidey::global_424 = 0;
        bind_signal_once(signal_id(hero(), "entity::DAMAGED"), _s07_gg_vs_spidey::set_hit_true());
        while (((!_s07_gg_vs_spidey::global_420) && (_s07_gg_vs_spidey::global_424 <= 35))) {
            _s07_gg_vs_spidey::global_424++;
            delay(0.1);
        }
        if ((!_s07_gg_vs_spidey::global_420)) {
            (hero()).ai_say_sound_group("s07_fireball_dodged", 0, 1);
        } else {
            delay(1);
            (hero()).ai_say_sound_group("s07_fireball_hit", 0, 1);
        }
        bind_signal_once(signal_id("FIREBALL_FIRED"), _s07_gg_vs_spidey::spidey_fireball_reaction());
    }

    void _s07_gg_vs_spidey::set_hit_true()
    {
        _s07_gg_vs_spidey::global_420 = 1;
    }

}
