    void effects_common::wait_fade_alpha(entity p4, num p8)
    {
        num v0 = 1;
        num v1 = (p4).get_render_alpha();
        num v2 = (v1 / p8);
        while ((v0 < p8)) {
            (p4).set_render_alpha((v1 - (v2 * v0)));
            wait_frame();
            v0++;
        }
        (p4).set_visible(0);
        (p4).set_render_alpha(1);
    }

    void effects_common::wait_fade_alpha_in(entity p4, num p8)
    {
        num v0 = 1;
        num v2 = (p4).get_render_alpha();
        num v1 = ((1 - v2) / p8);
        while ((v0 < p8)) {
            wait_frame();
            (p4).set_render_alpha((v1 * v0));
            v0++;
        }
        (p4).set_render_alpha(1);
    }

