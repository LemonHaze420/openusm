    void effects_common::shrink_trail(polytube p4, num p8)
    {
        num v0 = (p8 - 1);
        if (((p4).get_control_pt(0) != (p4).get_control_pt(v0))) {
            while ((v0 > 0)) {
                num v1 = distance3d((p4).get_control_pt(v0), (p4).get_control_pt((v0 - 1)));
                if ((v1 < 2)) {
                    (p4).set_control_pt(v0, (p4).get_control_pt((v0 - 1)));
                } else {
                    vector3d v3 = ((p4).get_control_pt((v0 - 1)) - (p4).get_control_pt(v0));
                    num v4 = (v3).length();
                    vector3d v2 = (v3 / v4);
                    (p4).set_control_pt(v0, ((p4).get_control_pt(v0) + (v2 * (v1 / 2))));
                }
                v0--;
            }
        } else {
            (p4).set_visible(0);
        }
    }

    void effects_common::shrink_trail_fast(polytube p4, num p8)
    {
        num v0 = (p8 - 5);
        if (((p4).get_control_pt(0) != (p4).get_control_pt((p8 - 1)))) {
            while ((v0 > 0)) {
                (p4).set_control_pt(v0, (p4).get_control_pt((v0 - 1)));
                (p4).set_control_pt((v0 + 1), (p4).get_control_pt(v0));
                (p4).set_control_pt((v0 + 2), (p4).get_control_pt(v0));
                (p4).set_control_pt((v0 + 3), (p4).get_control_pt(v0));
                (p4).set_control_pt((v0 + 4), (p4).get_control_pt(v0));
                v0--;
            }
        } else {
            (p4).set_visible(0);
        }
    }

