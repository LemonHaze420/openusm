    void _hj::mission_fail_spidey()
    {
        g_mission_status = 3;
        stop_vibration();
        stop_all_sounds();
        set_dialog_box_flavor(3);
        (hero()).reset_ai();
        start_thread(_hj::generic_spidey_lose_panel());
        delay(4.63);
        _hj::failure_dialog(-1);
    }

    void _hj::mission_fail_venom()
