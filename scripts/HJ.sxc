    void _hj::anybody_sinks(entity p0)
    {
        raise_signal(p0, "_cop_pistol::ENTITY_JUST_GOT_IN_WATER");
        entity v0;
        vector3d v2;
        if (((!(p0).is_a_car()) && (p0 != hero()))) {
            (p0).ai_shut_up();
        }
        if ((p0).is_a_car()) {
            v0 = create_time_limited_entity("effects\\aeps\\fx_carsplash", (2 + 1));
        } else {
            v0 = create_time_limited_entity("effects\\aeps\\fx_charactersplash", (2 + 1));
        }
        v2 = vector3d(((p0).get_abs_position()).x(), -3, ((p0).get_abs_position()).z());
        (v0).set_rel_position(v2);
        _hj::daytime_tint_effect(v0);
        {
            sound_inst v3;
            if ((p0).is_a_car()) {
                v3 = create_sound_inst("car_oceansplash");
            } else {
                v3 = create_sound_inst("sm_oceansplash");
            }
            (v3).set_entity(p0);
            (v3).play(0);
        }
        (p0).reset_ai();
        (p0).physical_ifc_cancel_all_velocity();
        if ((p0 != hero())) {
            (p0).set_visible(0);
            (p0).apply_damage(2000);
            (p0).apply_subdue(200);
        } else {
            freeze_hero(1);
            (hero()).set_visible(0);
            (hero()).set_physical(0);
            vector3d v1 = (hero()).get_abs_position();
            (hero()).set_rel_position(vector3d((v1).x(), -2, (v1).z()));
            spiderman_camera_set_hero_underwater(1);
        }
        delay(2);
        if ((p0 == hero())) {
            blackscreen_on(0.2);
            delay(0.2);
            spiderman_camera_set_hero_underwater(0);
            if ((g_mission_type == 4)) {
                freeze_hero(0);
                (hero()).set_visible(1);
                (hero()).set_physical(1);
                if ((is_hero_venom() && (g_mission_status == 7))) {
                    g_mission_status = 3;
                    _hj::mission_fail_venom();
                } else if ((g_mission_status == 7)) {
                    g_mission_status = 3;
                    _hj::mission_fail_spidey();
                }
            } else {
                (hero()).ai_say_sound_group("get_wet", 2, 2);
                freeze_hero(0);
                (hero()).set_visible(1);
                (hero()).set_physical(1);
                start_thread(_hj::do_it(p0));
                blackscreen_off(0.5);
                exit_water(p0);
            }
        }
        raise_signal(p0, "_cop_pistol::ENTITY_SINKS");
    }

    void _hj::do_it(entity p0)
