    void _hj::clear_all_scripts()
    {
        if (is_mission_loading()) {
            while ((!is_mission_active())) {
                wait_frame();
            }
        }
        unload_script();
        while (is_mission_active()) {
            wait_frame();
        }
    }

    void _hj::failure_dialog(num p0)
    {
        num v1 = 3;
        num v0 = 0;
        shut_up_all_ai_voice_boxes();
