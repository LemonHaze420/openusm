    void ENX_MASTER_OBJECT::begin_smoking(entity p4)
    {
        field_0 = create_entity("effects\\aeps\\fx_fire_1m");
        (field_0).set_state(2, 1);
        entity fx_fire_1m = (p4).get_member("HOOD");
        vector3d v1 = vector3d((random(1) - 0.5), 0, (random(1) - 0.5));
        field_4 = create_trigger(field_0, 1);
        (field_0).set_parent(p4);
        (field_0).set_rel_position(((fx_fire_1m).get_rel_position() + v1));
        bind_signal_on(this, signal_id(field_4, "trigger::ENTER"), (this).fire_damage());
        while (((p4).is_valid() && (p4).is_visible())) {
            wait_frame();
        }
        (field_4).clear_callbacks();
        destroy_trigger(field_4);
        destroy_entity(field_0);
    }

