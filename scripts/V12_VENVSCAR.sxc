    void _v12_venvscar::progression_mission_aborted()
    {
        if ((g_mission_type == 4)) {
            stop_vibration();
            clear_controls();
        }
        if (((hero()).get_ifc_num("HIT_POINTS") > 0)) {
            g_story_checkpoint = 0;
            if ((g_mission_type == 3)) {
                if ((!g_trick_race_controls_locked)) {
                    enable_controls(0);
                    clear_controls();
                    spiderman_camera_enable_lookaround(0);
                    g_trick_race_controls_locked = 1;
                }
                g_race_exited_via_pause = 1;
                g_done_with_storm_anim = 1;
            } else {
                blackscreen_on(0);
                spiderman_camera_clear_fixedstatic();
                if ((gv_num_current_story == 42)) {
                    g_mission_status = 2;
                    raise_signal("MISSION_END");
                } else {
                    _v12_venvscar::prepare_open_city_vars();
                    _v12_venvscar::clear_all_scripts();
                    if ((g_mission_type != 1)) {
                        _v12_venvscar::go_to_my_neighborhood(gv_hero_restart_pos);
                    }
                    raise_signal("MISSION_START_UPDATE");
                }
            }
            blackscreen_off(1);
        }
    }

