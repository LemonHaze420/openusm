                if ((gv_num_current_story == 42)) {
                    g_mission_status = 2;
                    raise_signal("MISSION_END");
                } else {
                    _v07_electro_chase::prepare_open_city_vars();
                    _v07_electro_chase::clear_all_scripts();
                    if ((g_mission_type != 1)) {
                        _v07_electro_chase::go_to_my_neighborhood(gv_hero_restart_pos);
                    }
