    void _v07_electro_chase::kill_shenanigans()
    {
        g_enable_sh = 0;
        g_enable_can = 0;
        wait_frame();
        if (is_mission_loading()) {
            while ((!is_mission_active())) {
                wait_frame();
            }
        }
        if ((is_mission_active() && (g_mission_type == 1))) {
            unload_script();
            while (is_mission_active()) {
                wait_frame();
            }
        }
    }

