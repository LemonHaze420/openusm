    void ENX_MASTER_OBJECT::prop_physics_collision(entity p4, entity p8, vector3d p12, vector3d p24)
    {
        entity v0;
        vector3d v2;
        if ((p4 == _wolverine::global_4)) {
            v0 = p8;
            v2 = p12;
        } else {
            v0 = p4;
            v2 = p24;
        }
        if (((v0).get_hash_name() == string_hash("ENT_BIKE"))) {
            vector3d v1 = (v0).get_ifc_vec("VELOCITY");
