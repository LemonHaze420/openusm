    }

    void ENX_MASTER_OBJECT::splode(entity p4)
    {
        wait_frame();
        vector3d v0 = (p4).get_abs_position();
        entity fx_explo_groundsm = create_entity("effects\\aeps\\fx_explo_groundsm");
        (fx_explo_groundsm).set_state(2, 1);
        (fx_explo_groundsm).set_rel_position(v0);
        (p4).set_visible(0);
        apply_radius_damage(v0, 6, 10, 0, 0);
        apply_radius_subdue(v0, 6, 10, 0, 0);
