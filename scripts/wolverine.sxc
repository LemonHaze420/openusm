    void motion_trail_effects::make_motion_trail(entity p4, entity p8)
    {
        num v4 = 0;
        vector3d v1 = (p8).get_abs_position();
        polytube v0 = create_polytube();
        (v0).set_rel_position(v1);
        (v0).reserve_control_pts(3);
        (v0).set_tube_radius(0.35);
        (v0).set_num_sides(2);
        (v0).build(8, 2);
        (v0).set_material("effects\\textures\\fx_m_trail");
        (v0).set_tiles_per_meter((0.94 / 1.3));
        (v0).set_max_length(1.3);
        (v0).compute_sector();
        (v0).set_distance_clip(10000);
        (v0).set_additive(1);
        (v0).set_visible(0);
        while ((v4 < 3)) {
            wait_frame();
            (v0).add_control_pt(v1);
            v4++;
        }
        while ((v1 == (p8).get_abs_position())) {
            wait_frame();
        }
        (v0).set_visible(1);
        vector3d v2 = (p8).get_abs_position();
        vector3d v6 = (v1 - v2);
        num v7 = (v6).length();
        vector3d v5 = (v6 / v7);
        vector3d v8 = (p4).get_abs_position();
        vector3d v9 = (v8 - v2);
        num v10 = (v9).length();
        vector3d v3 = (v9 / v10);
        (v0).set_control_pt(2, v2);
        (v0).set_control_pt(1, (v2 + (v5 * (1.3 / 2))));
        (v0).set_control_pt(0, (v2 + (v3 * 1.3)));
        start_thread_on(this, (this).fade_then_die(v0, 8));
    }

    void motion_trail_effects::fade_then_die(entity p4, num p8)
    {
        (field_0).wait_fade_alpha(p4, p8);
        destroy_entity(p4);
    }

