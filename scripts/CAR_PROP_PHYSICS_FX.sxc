    class ENX_MASTER_OBJECT
    {
    public:
        entity field_0;
        entity field_4;
        entity field_8;
        ENX_MASTER_OBJECT(entity p4);
        ~ENX_MASTER_OBJECT();
        void console_debug(str p4);
        void destroy();
        void cleanup();
        void wait_for_prop_phys_and_cleanup();
    };

    _car_prop_physics_fx::_car_prop_physics_fx(num p0)
    {
    }

    ENX_MASTER_OBJECT::ENX_MASTER_OBJECT(entity p4)
    {
        raise_signal("A_CAR_HAS_EXPLODED");
        vector3d v0 = (p4).get_abs_position();
        vector3d v1 = (v0 - vector3d(0, -0.5, 0));
        raise_signal(hero(), "entity::TRAFFIC_CAR_EXPLODED");
        field_0 = p4;
        (this).console_debug("constructor");
        if ((field_0).physical_ifc_is_prop_physics_running()) {
            bind_signal_once_on(this, signal_id(field_0, "entity::PROP_PHYSICS_STOP"), (this).destroy());
            (this).console_debug("added prop_physics_stop callback");
        } else {
            (this).console_debug("early exiting from prop physics");
            (this).destroy();
            return;
        }
        field_4 = create_entity("effects\\aeps\\fx_explo_groundmed");
        (field_4).set_state(2, 1);
        (field_4).set_rel_position(v1);
        field_8 = create_entity("effects\\entities\\fx_explo_light");
        (field_8).set_rel_position(v1);
        apply_radius_damage(v0, 6, 15, 0, 0);
        apply_radius_subdue(v0, 6, 0.5, 0, 0);
        ((field_8).get_member("Omni01")).wait_change_range(0.01, 0.01, 2.1);
    }

    ENX_MASTER_OBJECT::~ENX_MASTER_OBJECT()
    {
        (this).console_debug("destructor");
        (this).cleanup();
    }

    void ENX_MASTER_OBJECT::console_debug(str p4)
    {
        if ((field_0).is_valid()) {
        } else {
        }
    }

    void ENX_MASTER_OBJECT::destroy()
    {
        while (((gv_num_current_story == 19) && (g_mission_status == 7))) {
            wait_frame();
        }
        (this).console_debug("destroy");
        (this).cleanup();
        if ((field_0).is_valid()) {
            (field_0).wait_change_render_color((field_0).get_render_color(), 0, 2);
            destroy_entity(field_0);
        }
    }

    void ENX_MASTER_OBJECT::cleanup()
    {
        (this).console_debug("cleanup");
        if ((field_4).is_valid()) {
            destroy_entity(field_4);
        }
        if ((field_8).is_valid()) {
            destroy_entity(field_8);
        }
    }

    void ENX_MASTER_OBJECT::wait_for_prop_phys_and_cleanup()
    {
        wait_frame();
        while ((!(field_0).physical_ifc_is_prop_physics_at_rest())) {
            wait_frame();
        }
        (this).cleanup();
    }

