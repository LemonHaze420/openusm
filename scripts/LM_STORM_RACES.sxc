    void _lm_storm_races::disable_all_tokens()
    {
        enable_tokens_of_type(4, 0);
        enable_tokens_of_type(6, 0);
        enable_tokens_of_type(5, 0);
        enable_tokens_of_type(0, 0);
        enable_tokens_of_type(1, 0);
        enable_tokens_of_type(2, 0);
