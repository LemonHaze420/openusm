    void _lm_storm_races::enable_mission_tokens_by_hero()
    {
        if (is_hero_venom()) {
            enable_tokens_of_type(5, 1);
            enable_tokens_of_type(4, 0);
            enable_tokens_of_type(6, 0);
            enable_tokens_of_type(8, 0);
        } else {
            _lm_storm_races::set_up_tokens(gv_num_current_story, 0);
        }
