    void _lm_storm_races::enable_pickup_tokens()
    {
        enable_tokens_of_type(0, 1);
        enable_tokens_of_type(1, 1);
        enable_tokens_of_type(2, 1);
    }

    void _lm_storm_races::kill_shenanigans()
    {
        g_enable_sh = 0;
        g_enable_can = 0;
        _global_slc::wait_frame();
        if (is_mission_loading()) {
            while ((!is_mission_active())) {
                _global_slc::wait_frame();
            }
        }
        if ((is_mission_active() && (g_mission_type == 1))) {
            unload_script();
            while (is_mission_active()) {
                _global_slc::wait_frame();
            }
        }
    }

    void _lm_storm_races::launch_combat_tour(num p0)
    {
        turn_off_mission_text();
        (script_controller("CONTROLLER_1")).clear_callbacks();
        g_enable_token_event = 1;
        blackscreen_on(1);
        delay(1);
        _lm_storm_races::kill_shenanigans();
        gv_hero_restart_pos = (hero()).get_abs_position();
        gv_num_current_token_event = p0;
        _lm_storm_races::disable_mission_tokens();
    }

    void _lm_storm_races::on_combat_tour_enter(entity p0, num p4, str p8)
    {
