    }

    void _lm_storm_races::launch_trick_race(num p0)
    {
        if ((spiderman_is_on_ground() || spiderman_is_on_wall())) {
            blackscreen_on(1);
            delay(1);
            g_enable_trick_race = 1;
            _lm_storm_races::kill_shenanigans();
            g_mission_type = 3;
            (script_controller("CONTROLLER_1")).clear_callbacks();
            turn_off_mission_text();
            if ((!g_trick_race_controls_locked)) {
                g_trick_race_controls_locked = 1;
                enable_controls(0);
                clear_controls();
                spiderman_camera_enable_lookaround(0);
            }
            gv_num_current_token_event = p0;
        }
    }

    void _lm_storm_races::launch_venom_trick_race(num p0)
    {
        if ((spiderman_is_on_ground() || spiderman_is_on_wall())) {
            blackscreen_on(1);
            delay(1);
            if (g_enable_hot_pursuit) {
                g_enable_hot_pursuit = 0;
                unload_script();
            }
            g_enable_venom_trick_race = 1;
            _lm_storm_races::kill_shenanigans();
            g_mission_type = 3;
            (script_controller("CONTROLLER_1")).clear_callbacks();
            turn_off_mission_text();
            if ((!g_trick_race_controls_locked)) {
                g_trick_race_controls_locked = 1;
                enable_controls(0);
                clear_controls();
                spiderman_camera_enable_lookaround(0);
            }
            gv_num_current_token_event = p0;
        }
    }

    void _lm_storm_races::launch_torch_race(num p0)
    {
        if ((spiderman_is_on_ground() || spiderman_is_on_wall())) {
            blackscreen_on(1);
            delay(1);
            g_enable_storm_race = 1;
            _lm_storm_races::kill_shenanigans();
            g_mission_type = 3;
            (script_controller("CONTROLLER_1")).clear_callbacks();
            turn_off_mission_text();
            if ((!g_trick_race_controls_locked)) {
                enable_controls(0);
                clear_controls();
                spiderman_camera_enable_lookaround(0);
                g_trick_race_controls_locked = 1;
            }
            gv_num_current_token_event = p0;
        }
    }

    void _lm_storm_races::initialize_location_mission()
    {
        g_enable_sh = 0;
        g_enable_can = 0;
        g_enable_token_event = 0;
        g_enable_pn = 0;
        g_entity_list = create_entity_list();
        g_mission_status = 1;
        _lm_storm_races::set_hood_gang();
    }

    void _lm_storm_races::breakdown_location_mission()
    {
        destroy_entity_list(g_entity_list);
        if ((!g_enable_story)) {
            _lm_storm_races::prepare_open_city_vars();
            raise_signal("MISSION_START_UPDATE");
        }
        g_mission_status = 0;
    }

