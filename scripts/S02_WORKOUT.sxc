    void _s02_workout::set_up_tokens(num p0, num p4)
    {
        if ((_s02_workout::convert_to_progression_step(p0) <= _s02_workout::convert_to_progression_step(35))) {
            _s02_workout::disable_all_tokens();
        } else {
            _s02_workout::enable_pickup_tokens();
            if (((g_mission_type == 0) || (g_mission_type == 1))) {
                _s02_workout::set_torch_token(p4);
                if (is_hero_spidey()) {
                    _s02_workout::set_tour_tokens();
                    enable_tokens_of_type(4, 1);
                    enable_tokens_of_type(5, 0);
                } else {
                    enable_tokens_of_type(4, 0);
                    if (gv_story_finished) {
                        enable_tokens_of_type(5, 1);
                    }
                }
                if (((_s02_workout::convert_to_progression_step(p0) > _s02_workout::convert_to_progression_step(40)) && is_hero_spidey())) {
                    enable_tokens_of_type(6, 1);
                } else {
                    enable_tokens_of_type(6, 0);
                }
            }
        }
    }

    void _s02_workout::set_spiderman_health()
    {
        switch (gv_health_ulocked) {
        case 3:
        {
            turn_on_hero_health(3, hero());
            break;
        }
        case 2:
        {
            turn_on_hero_health(2, hero());
            break;
        }
        case 1:
        {
            turn_on_hero_health(1, hero());
            break;
        }
        default:
        {
            turn_on_hero_health(0, hero());
            break;
        }
        }
        (hero()).set_ifc_num("MAX_HIT_POINTS", gv_current_max_hitpoints);
        (hero()).set_ifc_num("HIT_POINTS", (hero()).get_ifc_num("MAX_HIT_POINTS"));
    }

    void _s02_workout::city_goals_hint()
    {
        while ((!gv_master_prog[gv_obj_list_needed])) {
            delay(180);
            while ((g_mission_status != 0)) {
                delay(1);
            }
            if ((!gv_master_prog[gv_obj_list_needed])) {
                set_mission_text_box_flavor(1);
                set_mission_text(275);
                delay(5);
                turn_off_mission_text();
            }
        }
    }

    void _s02_workout::process_master_objective()
    {
        num v0 = 0;
        while (((v0 < 13) && (((gv_tour_prog[v0] && gv_token_prog[v0]) && gv_shen_prog[v0]) && gv_race_prog[v0]))) {
            if ((!gv_master_prog[v0])) {
                gv_master_prog[v0] = 1;
                gv_shen_speed_normal = 1;
                _s02_workout::update_open_city_shen_times();
                if (((v0 == gv_obj_list_needed) && (v0 > 0))) {
                    kill_threads(_s02_workout::city_goals_hint);
                    if ((_s02_workout::convert_to_progression_step(gv_num_current_story) <= _s02_workout::convert_to_progression_step(3))) {
                        set_dialog_box_flavor(1);
                        bring_up_dialog_box_title(133, 1, 132);
                    } else {
                        set_dialog_box_flavor(2);
                        bring_up_dialog_box_title(274, 1, 175);
                    }
                }
            }
            v0 = (v0 + 1);
        }
        raise_signal("MISSION_START_UPDATE");
    }

