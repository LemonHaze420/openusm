    void _v10_beetle_battle::debug_jump(debug_menu_entry p0)
    {
        remove_glass_house("v10_stage1_gh");
        switch ((p0).get_id()) {
        case 0:
        {
            kill_threads(_v10_beetle_battle::distance_checker);
            kill_threads(_v10_beetle_battle::damage_watcher_p3);
            (_v10_beetle_battle::global_32).clear_callbacks();
            _v10_beetle_battle::stage1_start();
            break;
        }
        case 1:
        {
            kill_threads(_v10_beetle_battle::damage_watcher_p3);
            (_v10_beetle_battle::global_32).clear_callbacks();
            _v10_beetle_battle::stage2_start();
            break;
        }
        case 2:
        {
            kill_threads(_v10_beetle_battle::distance_checker);
            (_v10_beetle_battle::global_32).clear_callbacks();
            _v10_beetle_battle::stage3_start(0);
            break;
        }
        case 3:
        {
            kill_threads(_v10_beetle_battle::distance_checker);
            (_v10_beetle_battle::global_32).clear_callbacks();
            _v10_beetle_battle::stage3_start(1);
            break;
        }
        case 4:
        {
            _v10_beetle_battle::floor_breakA();
            break;
        }
        case 5:
        {
            _v10_beetle_battle::floor_breakB();
            break;
        }
        case 6:
        {
            _v10_beetle_battle::floor_breakC();
            break;
        }
        case 7:
        {
            _v10_beetle_battle::raise_walls();
            break;
        }
        case 8:
        {
            g_story_checkpoint = 5;
            unload_script();
            break;
        }
        case 9:
        {
            g_story_checkpoint = 6;
            unload_script();
            break;
        }
        case 97:
        {
            num v1 = (_v10_beetle_battle::global_32).get_ifc_num("HIT_POINTS");
            v1 = (v1 / 2);
            (_v10_beetle_battle::global_32).set_ifc_num("HIT_POINTS", v1);
            break;
        }
        case 98:
        {
            (hero()).set_ifc_num("HIT_POINTS", 0);
            break;
        }
        case 99:
        {
            _v10_beetle_battle::mission_complete();
            break;
        }
        case 100:
        {
            _v10_beetle_battle::bomber_mode();
            break;
        }
        }
    }

    void _v10_beetle_battle::mission_failed()
    {
        if (((!_v10_beetle_battle::global_284) && (g_mission_status != 3))) {
            g_mission_status = 3;
            _v10_beetle_battle::global_284 = 1;
            _v10_beetle_battle::mission_cleanup();
            _v10_beetle_battle::mission_fail_venom_specific(250);
        }
    }

    void _v10_beetle_battle::mission_complete()
    {
        _v10_beetle_battle::destroy_beetle();
        turn_off_boss_health();
        _v10_beetle_battle::play_ending_cutscene();
        _v10_beetle_battle::play_spidey_transition_cutscene();
        enable_mini_map(1);
        g_story_checkpoint = 0;
        g_mission_status = 2;
        raise_signal("MISSION_END");
        while (is_mission_active()) {
            _global_slc::wait_frame();
        }
    }

    void _v10_beetle_battle::mission_cleanup()
    {
        (_v10_beetle_battle::beetle_controller).beetle_trail_off();
        turn_off_boss_health();
    }

    void _v10_beetle_battle::turn_off_mission_text(num p0)
    {
        delay(p0);
        _global_slc::turn_off_mission_text();
    }

    void _v10_beetle_battle::mission_called_from_debug_menu()
    {
        g_enable_sh = 0;
        g_enable_story = 1;
        gv_num_current_story = 18;
        raise_signal("MISSION_START_UPDATE");
    }

    void _v10_beetle_battle::win_v10(debug_menu_entry p0)
    {
        _v10_beetle_battle::mission_complete();
        malor(vector3d(455, 1.5, 346), -1410);
    }

