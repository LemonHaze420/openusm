    void _v10_beetle_battle::progression_mission_failed()
    {
        blackscreen_on(0);
        spiderman_camera_clear_fixedstatic();
        _v10_beetle_battle::prepare_open_city_vars();
        _v10_beetle_battle::clear_all_scripts();
