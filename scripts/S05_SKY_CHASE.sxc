    void _s05_sky_chase::turn_on_beetle_trail()
    {
        entity v0 = find_entity("beetle");
        vector3d v2 = vector3d(1, 1, 0);
        num v3 = 0;
        polytube v1 = create_polytube();
        (v1).set_rel_position(vector3d(0, 0, 0));
        (v1).reserve_control_pts(14);
        while ((v3 < 14)) {
            _global_slc::wait_frame();
            (v1).add_control_pt(vector3d(0, -0.1, 0));
            v3++;
        }
        (v1).set_tube_radius(1);
        (v1).set_num_sides(2);
        (v1).build(3, 2);
        (v1).set_material("effects\\textures\\fx_beetle_trailend_01");
        (v1).set_tiles_per_meter(0.18);
        (v1).set_render_alpha(0.5);
        (v1).set_render_color(v2);
        (v1).set_additive(1);
        (v1).compute_sector();
        (v1).set_distance_clip(10000);
        (v1).set_visible(1);
        _s05_sky_chase::appear(v1);
        (_s05_sky_chase::s05_common).field_0 = 1;
        (_s05_sky_chase::s05_common).animate_trail(v0, v1, 70, 0);
    }

