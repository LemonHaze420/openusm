    void _s05_sky_chase::progression_mission_aborted()
    {
        if ((g_mission_type == 4)) {
            stop_vibration();
            clear_controls();
        }
        if (((hero()).get_ifc_num("HIT_POINTS") > 0)) {
            g_story_checkpoint = 0;
            if ((g_mission_type == 3)) {
                if ((!g_trick_race_controls_locked)) {
