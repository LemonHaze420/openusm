                _s05_sky_chase::mission_failed(p4);
            }
        } else {
            blackscreen_on(1);
            (_s05_sky_chase::TAM1man).finish();
            (_s05_sky_chase::TAM1woman).finish();
            (_s05_sky_chase::TAM3car1).finish();
            (_s05_sky_chase::TAM3car2).finish();
            (_s05_sky_chase::TAM3car3).finish();
            (_s05_sky_chase::TAM4woman).finish();
            g_story_checkpoint = 0;
            gv_shen_diff_stage_two_completed = 1;
            _s05_sky_chase::update_shen_difficulty();
            g_mission_status = 2;
            raise_signal("MISSION_END");
        }
        while (is_mission_active()) {
            _global_slc::wait_frame();
        }
    }

    void _s05_sky_chase::clean_garbage()
    {
        (_s05_sky_chase::TAM1man).finish();
        (_s05_sky_chase::TAM1woman).finish();
        (_s05_sky_chase::TAM3car1).finish();
        (_s05_sky_chase::TAM3car2).finish();
        (_s05_sky_chase::TAM3car3).finish();
        (_s05_sky_chase::TAM4woman).finish();
        spiderman_camera_enable_combat(1);
    }

    void _s05_sky_chase::mission_failed(num p0)
    {
        (_s05_sky_chase::TAM1man).finish();
        (_s05_sky_chase::TAM1woman).finish();
        (_s05_sky_chase::TAM3car1).finish();
        (_s05_sky_chase::TAM3car2).finish();
        (_s05_sky_chase::TAM3car3).finish();
        (_s05_sky_chase::TAM4woman).finish();
        if (((p0 == 0) && (g_mission_status != 3))) {
            g_mission_status = 3;
            _s05_sky_chase::mission_fail_spidey_specific(250);
            delay(10);
        } else if ((g_mission_status != 3)) {
            g_mission_status = 3;
            _s05_sky_chase::mission_fail_spidey_specific(251);
            delay(10);
        }
    }

    void _s05_sky_chase::mission_called_from_debug_menu()
    {
        g_enable_sh = 0;
        g_enable_story = 1;
        gv_num_current_story = 8;
        raise_signal("MISSION_START_UPDATE");
    }

