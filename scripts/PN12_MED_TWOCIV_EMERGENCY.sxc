    void _pn12_med_twociv_emergency::set_hero(str p0)
    {
        stop_vibration();
        vector3d v0 = (hero()).get_abs_position();
        swap_hero_costume(p0);
        malor(v0, 1);
        spiderman_camera_autocorrect(0);
        if (is_hero_spidey()) {
            _pn12_med_twociv_emergency::set_spiderman_health();
        } else {
            turn_on_hero_health(4, hero());
