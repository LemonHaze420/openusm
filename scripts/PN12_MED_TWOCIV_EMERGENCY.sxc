    void _pn12_med_twociv_emergency::wait_frame(num p0)
    {
        while ((p0 > 0)) {
            _global_slc::wait_frame();
            p0--;
        }
    }

    num _pn12_med_twociv_emergency::distance2d(vector3d p0, vector3d p12)
    {
        vector3d v0 = (p0 + vector3d(0, (-(p0).y()), 0));
        vector3d v1 = (p12 + vector3d(0, (-(p12).y()), 0));
        num v2 = distance3d(v0, v1);
