    }

    void _pn12_med_twociv_emergency::limbo_guardian(entity p0)
    {
        district v0 = (p0).get_district();
        vector3d v1 = (p0).get_abs_position();
        while ((p0).is_valid()) {
            while ((v0).is_loaded()) {
                _global_slc::wait_frame();
            }
            while ((!(v0).is_loaded())) {
                _global_slc::wait_frame();
            }
            (p0).set_rel_position(v1);
            (p0).set_visible(1);
        }
    }

    void _pn12_med_twociv_emergency::update_shen_difficulty()
    {
        if ((gv_shen_difficulty != 2)) {
            if ((gv_shen_diff_stage_one_completed && (gv_shens_successfully_completed >= 10))) {
                gv_shen_difficulty = 1;
            }
            if ((gv_shen_diff_stage_two_completed && (gv_shens_successfully_completed >= 20))) {
                gv_shen_difficulty = 2;
            }
        }
    }

    void _pn12_med_twociv_emergency::clear_all_scripts()
    {
        if (is_mission_loading()) {
            while ((!is_mission_active())) {
                _global_slc::wait_frame();
            }
        }
        unload_script();
        while (is_mission_active()) {
            _global_slc::wait_frame();
        }
    }

    void _pn12_med_twociv_emergency::go_to_my_neighborhood(vector3d p0)
    {
        district v2;
        district v1;
        num v3 = 0;
        if ((hero()).physical_ifc_is_biped_physics_running()) {
            (hero()).physical_ifc_stop_biped_physics();
        }
        if (is_hero_venom()) {
            malor(RESPAWN_CENTRAL_PARK, 1);
        } else {
            v2 = find_district_for_point(p0);
            v3 = (v2).get_neighborhood();
            switch (v3) {
            case 0:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            case 1:
            {
                malor(RESPAWN_ESU, 1);
                break;
            }
            case 2:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            case 3:
            {
                malor(RESPAWN_DAILY_BUGLE, 1);
                break;
            }
            default:
            {
                malor(RESPAWN_PETERS_HOUSE, 1);
                break;
            }
            }
        }
        v1 = find_district_for_point((hero()).get_abs_position());
        (v1).wait_for_load();
        wait_for_streamer_to_reach_equilibrium();
    }

