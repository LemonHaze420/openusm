    void _pn12_med_twociv_emergency::set_hero_costume(str p0)
    {
        blackscreen_on(0);
        stop_vibration();
        kill_threads(_pn12_med_twociv_emergency::run_hot_pursuit);
        g_enable_hot_pursuit = 0;
        _pn12_med_twociv_emergency::clear_all_scripts();
        _pn12_med_twociv_emergency::set_hero(p0);
        _pn12_med_twociv_emergency::prepare_open_city_vars();
        blackscreen_off(1);
    }

    void _pn12_med_twociv_emergency::toggle_hero()
    {
        blackscreen_on(0);
        stop_vibration();
